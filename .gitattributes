# Normalise line endings in the repository.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf

# Shell wrapper must stay executable and LF.
gradlew text eol=lf

# Binaries — never diff or convert.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ttf binary
*.otf binary
*.zip binary
*.apk binary
*.aab binary
